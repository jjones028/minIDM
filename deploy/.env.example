# Copy to /opt/minidm/.env on the Droplet and fill in real values.
# This file is read by compose.prod.yaml at startup.

# --- Database ---
DB_USER=minidm
DB_PASSWORD=change_me_use_a_strong_password
DB_NAME=minidm

# Full DATABASE_URL is also used by the migrate workflow.
DATABASE_URL=postgres://minidm:change_me_use_a_strong_password@db:5432/minidm?sslmode=disable

# --- App ---
# Must be the externally reachable URL (used in JWT iss claim and OIDC discovery).
OAUTH2_ISSUER=https://your-domain.com

# Registry image — the deploy workflow sets this automatically.
IMAGE=registry.digitalocean.com/your-registry/minidm:latest
